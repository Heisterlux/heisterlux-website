{
  "name": "heisterlux-website",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "test": "node --test \"tests/**/*.test.ts\"",
    "verify:dist": "node scripts/verify-dist.ts",
    "verify:contrast": "node scripts/contrast.ts",
    "serve:output": "node scripts/serve-output.ts",
    "verify": "npm run check && npm test && npm run verify:contrast && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "@astrojs/vercel": "11.0.11",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.19.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "path-to-regexp@6": "6.3.0"
  }
}
