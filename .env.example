# No secrets are required to build or preview this site.
#
# FORMS_MODE controls form submission handling.
#   disabled (default, also used for any unknown value): submissions are refused with a clear message.
#   sandbox: local in-memory test provider. Refused when VERCEL_ENV=production.
# There is no live provider wired yet (launch gate G-FORMS).
FORMS_MODE=disabled

# Indexing is only enabled when BOTH are true at build time:
#   VERCEL_ENV=production (set by Vercel) and PUBLIC_SITE_INDEXABLE=true (explicit release decision).
PUBLIC_SITE_INDEXABLE=false
