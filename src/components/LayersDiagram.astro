---
/**
 * The four layers, linked but separate. Summary image only; the page renders the full text
 * explanation as a visible list referenced by aria-describedby.
 */
interface Props {
  layers: readonly { id: string; title: string }[];
  connectors: readonly string[];
  label: string;
  describedBy: string;
}
const { layers, connectors, label, describedBy } = Astro.props;
const H = 60;
const GAP = 44;
const total = layers.length * H + (layers.length - 1) * GAP;
---

<figure class="diagram diagram--layers">
  <svg viewBox={`0 0 360 ${total}`} role="img" aria-label={label} aria-describedby={describedBy}>
    <defs>
      <marker id="layer-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path class="d-arrow" d="M0 0 L10 5 L0 10 z"></path>
      </marker>
    </defs>
    {layers.map((l, i) => {
      const y = i * (H + GAP);
      return (
        <g>
          <rect class={i === layers.length - 1 ? 'd-box d-box--accent' : 'd-box'} x="1" y={y + 1} width="358" height={H - 2} rx="8"></rect>
          <text class="d-label" x="180" y={y + H / 2 + 5} text-anchor="middle">{l.title}</text>
          {i < layers.length - 1 && (
            <g>
              <line class="d-line" x1="60" y1={y + H} x2="60" y2={y + H + GAP - 2} marker-end="url(#layer-arrow)"></line>
              <text class="d-sub" x="76" y={y + H + GAP / 2 + 4}>{connectors[i]}</text>
            </g>
          )}
        </g>
      );
    })}
  </svg>
</figure>

<style>
  .diagram--layers {
    max-inline-size: 26rem;
  }
</style>
