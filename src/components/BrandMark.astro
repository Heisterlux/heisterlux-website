---
/* Abstract mark: a lens (visibility) with a single steady line through it. Decorative. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <circle cx="16" cy="16" r="12.5" fill="none" stroke="currentColor" stroke-width="2.5"></circle>
  <path d="M8 19.5 L13.5 14 L18 18 L24 11.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
