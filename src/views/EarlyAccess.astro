---
import FormBlock from '../components/FormBlock.astro';
import { copy } from '../content/copy/index.ts';
import { pathFor } from '../content/routes.ts';
import type { LocaleCode } from '../i18n/locales.ts';
import { resolveFormsMode } from '../lib/forms/providers.ts';

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const c = copy(locale).earlyAccess;
// Static page: the rendered state reflects the build-time mode; the server enforces it again.
const mode = resolveFormsMode({
  FORMS_MODE: process.env.FORMS_MODE,
  VERCEL: process.env.VERCEL,
  VERCEL_ENV: process.env.VERCEL_ENV,
  VERCEL_URL: process.env.VERCEL_URL,
});
---

<div class="container">
  <header class="page-head">
    <h1>{c.heading}</h1>
    <p class="lead">{c.lead}</p>
  </header>

  <section aria-labelledby="what-heading">
    <h2 id="what-heading">{c.whatHeading}</h2>
    <ul>{c.whatItems.map((i) => <li>{i}</li>)}</ul>
  </section>

  <section aria-labelledby="request-heading">
    <h2 id="request-heading">{c.formHeading}</h2>
    <FormBlock locale={locale} formId="early-access" mode={mode} />
  </section>

  <section aria-labelledby="keep-heading">
    <h2 id="keep-heading">{c.keepHeading}</h2>
    <p>{c.keepText}</p>
    <FormBlock locale={locale} formId="keep-informed" mode={mode} />
  </section>

  <p class="muted"><a href={pathFor('privacy', locale)}>{copy(locale).privacy.heading}</a></p>
</div>
