---
import LinkedInButton from '../components/LinkedInButton.astro';
import { copy } from '../content/copy/index.ts';
import { pathFor } from '../content/routes.ts';
import type { LocaleCode } from '../i18n/locales.ts';

interface Props {
  locale: LocaleCode;
}
const { locale } = Astro.props;
const c = copy(locale).earlyAccess;
const l = copy(locale).linkedin;
---

<div class="container">
  <header class="page-head">
    <h1>{c.heading}</h1>
    <p class="lead">{c.lead}</p>
  </header>

  <section aria-labelledby="linkedin-heading">
    <h2 id="linkedin-heading">{l.heading}</h2>
    <p>{l.text}</p>
    <div class="button-row">
      <LinkedInButton locale={locale} />
    </div>
  </section>

  <p class="muted"><a href={pathFor('privacy', locale)}>{copy(locale).privacy.heading}</a></p>
</div>
